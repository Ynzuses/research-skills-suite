{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manage Workspace Memory Bootstrap Manifest",
  "description": "A root-bound, create-only plan produced after semantic workspace design. Pending manifests are intentionally non-executable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval",
    "workspace",
    "directories",
    "files",
    "entry"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "workspace": {
      "$ref": "#/$defs/workspace"
    },
    "directories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relativePath"
      },
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/controlFile"
      }
    },
    "entry": {
      "$ref": "#/$defs/entry"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "approval": {
            "properties": {
              "state": {
                "const": "approved"
              }
            },
            "required": [
              "state"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "decision_id": {
                "type": "string",
                "minLength": 2,
                "maxLength": 200
              },
              "approved_by_role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "approved_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "manifest_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "workspace": {
            "properties": {
              "root_identity": {
                "$ref": "#/$defs/approvedRootIdentity"
              },
              "frozen_inventory_complete": {
                "const": true
              }
            }
          },
          "entry": {
            "properties": {
              "path": {
                "$ref": "#/$defs/relativePath"
              },
              "content": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1048576
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "nullableNonEmptyString": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 500
    },
    "nullableSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "decision_id",
        "approved_by_role",
        "approved_at",
        "manifest_sha256"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending",
            "approved"
          ]
        },
        "decision_id": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "approved_by_role": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "approved_at": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "root_identity",
        "frozen_inventory_complete",
        "frozen_paths"
      ],
      "properties": {
        "root": {
          "const": "."
        },
        "root_identity": {
          "$ref": "#/$defs/rootIdentity"
        },
        "frozen_inventory_complete": {
          "type": "boolean"
        },
        "frozen_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "uniqueItems": true
        }
      }
    },
    "rootIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalized_path_sha256",
        "device",
        "inode"
      ],
      "properties": {
        "normalized_path_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "device": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "inode": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "approvedRootIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalized_path_sha256",
        "device",
        "inode"
      ],
      "properties": {
        "normalized_path_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "device": {
          "type": "integer",
          "minimum": 0
        },
        "inode": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "controlFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "content",
        "content_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "role": {
          "enum": [
            "workspace_rules",
            "long_term_memory",
            "current_status",
            "stable_design",
            "asset_index",
            "dependency_graph",
            "history",
            "topic_memory",
            "workspace_blueprint",
            "audit_index"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "create_if_missing",
        "operation",
        "previous_managed_block_sha256",
        "managed_block_id",
        "content",
        "content_sha256"
      ],
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 500
        },
        "create_if_missing": {
          "type": "boolean"
        },
        "operation": {
          "enum": [
            "merge",
            "update"
          ]
        },
        "previous_managed_block_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "managed_block_id": {
          "const": "manage-workspace-memory-v1"
        },
        "content": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1048576
        },
        "content_sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    }
  }
}
